{
  "name": "dev-engines-installer",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/index.js",
    "build": "bun run scripts/build.js",
    "test": "vitest run --coverage",
    "unit": "vitest --coverage",
    "lint": "eslint *.js src tests",
    "fix": "npm run lint -- --fix",
    "outdated": "npm outdated"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "all-caps-path": "^0.3.0",
    "bun": "^1.3.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "eslint-config-tjw-base": "^5.0.0",
    "eslint-config-tjw-import-x": "^1.0.1",
    "eslint-config-tjw-jest": "^4.0.0",
    "eslint-config-tjw-jsdoc": "^2.0.1",
    "eslint-import-resolver-vite": "^2.1.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jsdoc": "^62.9.0",
    "globals": "^17.5.0",
    "memfs": "^4.57.2",
    "vitest": "^4.1.4"
  },
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": "25.9.0"
      },
      {
        "name": "bun",
        "version": "1.3.12"
      }
    ],
    "packageManager": {
      "name": "npm",
      "version": "11.12.1"
    }
  }
}
